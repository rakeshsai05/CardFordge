# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection - MongoDB Atlas
# Replace with your MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campuspass?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://3sairakesh200_db_user:<db_password>@rakeshsai.ixwrb0e.mongodb.net/
# JWT Authentication
# Set a unique 32+ character secret. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-64-character-random-secret
JWT_EXPIRES_IN=7d

# Optional platform owner account (never commit these secrets)
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# File Upload Configuration (max size in bytes: 2MB)
MAX_FILE_SIZE=2097152
